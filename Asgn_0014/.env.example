# Assign_0014 run config template — copy to .env (gitignored). No API keys.
# Colab:  cp .env.example .env   then set ASSGN014_HOST=colab

ASSGN014_HOST=local
ASSGN014_GPU_NAME=

# Advertised USD/hour (McCormick Colab units, 2026-03-10; 0.10 USD/unit):
#   Colab T4            0.12
ASSGN014_USD_PER_HOUR=0.12
ASSGN014_FREE_COLAB=0

ASSGN014_SEQ_LEN=512
# Colab T4: use 8 (peak MoE ~2GB; 16GB headroom). CPU smoke may use 2.
ASSGN014_BATCH=8
ASSGN014_TOKENS_DENSE=25000000
ASSGN014_TOKENS_MOE=25000000
ASSGN014_SMOKE_TOKENS_DENSE=4096
ASSGN014_SMOKE_TOKENS_MOE=4096

ASSGN014_LR=0.0003
# Leave blank to use CLI / code defaults (8 experts, top_k=2).
ASSGN014_N_EXPERTS=
ASSGN014_TOP_K=
ASSGN014_BIAS_GAMMA=0.001
ASSGN014_DROP_REDRAW=0.5
ASSGN014_WARMUP_STEPS=2000
# Folder id tag: vNNN_host_gpu_budget_kind_<tag>
# wu_phase = warm-up auto-extends to cover the full MoE phase (fixes v015-style collapse)
ASSGN014_VERSION_TAG=wu_phase_corpus

# corpus = TinyStories/BPE8192 packed batches (graded learning proof)
# synthetic = randint (wiring only; CE stays near ln(V) — not coach-grade)
ASSGN014_DATA=corpus

ASSGN014_RUN_VERSION=
# Colab Drive example: /content/drive/MyDrive/Assign_0014/reports
ASSGN014_REPORTS_ROOT=
