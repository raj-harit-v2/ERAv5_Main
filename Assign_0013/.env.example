# Assign_0013 run config template — copy to .env (gitignored). No API keys.
# Colab:  cp .env.example .env   then set ASSGN013_HOST=colab
# The colab zip ships this file only (never a real .env).

ASSGN013_HOST=colab
ASSGN013_GPU_NAME=

# Advertised USD/hour (McCormick Colab units, 2026-03-10; 0.10 USD/unit):
#   free Colab          0.00   (set ASSGN013_FREE_COLAB=1; usd_shadow uses T4 0.12)
#   Colab T4            0.12   (1.19 units/h)  <-- default for class GPU
#   Colab L4            0.17   (1.71 units/h)
#   Colab A100 40GB     0.54   (5.40 units/h)
#   Colab A100 80GB     0.75   (7.52 units/h)
#   Enterprise T4       0.49   (Google list 0.42 + 0.07 fee)
ASSGN013_USD_PER_HOUR=0.12
ASSGN013_FREE_COLAB=0

ASSGN013_SEQ_LEN=512
ASSGN013_TOKENS=50000000
ASSGN013_SMOKE_TOKENS=100000

# Leave empty so Colab/GPU OOM probe sets them (do not copy laptop B_fixed).
ASSGN013_B_FIXED=
ASSGN013_B_MAX=

ASSGN013_H=0.25
ASSGN013_BLEND=0.5
ASSGN013_LR=0.0003
ASSGN013_WEIGHT_DECAY=0.0
ASSGN013_DROPOUT=0.0
ASSGN013_VARIANT=midpoint

ASSGN013_RUN_VERSION=
ASSGN013_REPORTS_ROOT=
